{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/api/Jyz/bin/Debug/net10.0/Jyz.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/api/Jyz",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5000;"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+?:(\\d+)",
        "uriFormat": "https://localhost:%s/scalar/v1"
      },
      "presentation": {
        "group": "fullstack",
        "order": 1
      }
    },
    {
      "type": "chrome",
      "name": "Launch Frontend",
      "request": "launch",
      "url": "http://localhost:5666",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/src/web/apps/web-antd",
      "preLaunchTask": "vue: dev",
      "presentation": {
        "group": "fullstack",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "Both (Backend + Frontend)",
      "configurations": ["Launch Backend", "Launch Frontend"],
      "stopAll": true
    }
  ]
}
